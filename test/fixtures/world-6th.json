    "prefix": "#",
    "header": "# Kibo Nav Sandbox route for: {world} (inspired by Kibo-RPC)\n# Not an official Kibo-RPC API: Kibo-RPC robot programs are written in Java.\n# Runs as-is with Python 3 and prints each move. Replace move_to() to drive your own simulator.\nfrom collections import namedtuple\n\nPoint = namedtuple(\"Point\", \"x y z\")\nQuaternion = namedtuple(\"Quaternion\", \"x y z w\")  # [x, y, z, w], camera looks along body +X\n\n\ndef move_to(point, quaternion):\n    print(\"move_to\", tuple(point), tuple(quaternion))\n",
