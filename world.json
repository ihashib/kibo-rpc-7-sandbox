  "export": {
    "prefix": "//",
    "header": "// KIBO RPC 7 Nav Sandbox route for: {world} (inspired by Kibo-RPC; check every value in the simulator)\n// Paste into the mission flow of src/user_template_node.cpp, after mission_start.\n// Checkpoints change every run: a real program reads them from /mission/get_checkpoints.\n// Needs <actionlib/client/simple_action_client.h>, <ib2_msgs/CtlCommandAction.h> and\n// <krpc_ib2_msgs/CheckpointPassedAction.h>. If your template already has these Action clients, use\n// them instead, and make your /ib2_user/stop handler cancel their goals.\nactionlib::SimpleActionClient<ib2_msgs::CtlCommandAction> move_client(\"/ctl/command\", true);\nactionlib::SimpleActionClient<krpc_ib2_msgs::CheckpointPassedAction> cp_client(\"/event/checkpoint_passed\", true);\nmove_client.waitForServer(ros::Duration(10.0));\ncp_client.waitForServer(ros::Duration(10.0));\nauto move_to = [&](double x, double y, double z, double qx, double qy, double qz, double qw) {\n  ib2_msgs::CtlCommandGoal goal;\n  goal.target.header.frame_id = \"iss_body\";\n  goal.target.header.stamp = ros::Time::now();\n  goal.target.pose.position.x = x;\n  goal.target.pose.position.y = y;\n  goal.target.pose.position.z = z;\n  goal.target.pose.orientation.x = qx;\n  goal.target.pose.orientation.y = qy;\n  goal.target.pose.orientation.z = qz;\n  goal.target.pose.orientation.w = qw;\n  goal.type.type = ib2_msgs::CtlStatusType::MOVE_TO_ABSOLUTE_TARGET;\n  move_client.sendGoal(goal);\n  if (!move_client.waitForResult(ros::Duration(60.0))) { move_client.cancelGoal(); return false; }\n  return move_client.getResult()->type == ib2_msgs::CtlCommandResult::TERMINATE_SUCCESS;\n};\nauto pass_checkpoint = [&](int id) {\n  ros::Duration(1.0).sleep();  // let it settle before the judge looks\n  krpc_ib2_msgs::CheckpointPassedGoal goal;\n  goal.checkpoint_id = id;\n  cp_client.sendGoal(goal);\n  if (!cp_client.waitForResult(ros::Duration(10.0))) { cp_client.cancelGoal(); return false; }\n  bool ok = cp_client.getResult()->success;\n  ROS_INFO(\"checkpoint %d passed: %s\", id, ok ? \"yes\" : \"no\");\n  return ok;\n};",
    "comment": "// {i}. {name}",
    "line": "if (!move_to({x}, {y}, {z}, {qx}, {qy}, {qz}, {qw})) ROS_WARN(\"move {i} did not finish\");",
    "pass": "pass_checkpoint({cp});",
    "footer": "// Then call /event/mission_finished (the template does this after the flow)."
  },
  "exportPython": {
    "prefix": "            #",
    "header": "            # KIBO RPC 7 Nav Sandbox route for: {world} (inspired by Kibo-RPC; check every value in the simulator)\n            # Paste between the USER EDIT AREA markers in __run_user_flow() (scripts/user_template.py).\n            # Checkpoints change every run: a real program reads them from /mission/get_checkpoints.\n            def move_to(x, y, z, qx, qy, qz, qw, timeout=60.0):\n                if not self.__command.wait_for_server(rospy.Duration(10.0)):\n                    return False\n                target = PoseStamped()\n                target.header.frame_id = 'iss_body'\n                target.header.stamp = rospy.Time.now()\n                p, o = target.pose.position, target.pose.orientation\n                p.x, p.y, p.z = x, y, z\n                o.x, o.y, o.z, o.w = qx, qy, qz, qw\n                goal = CtlCommandGoal(target=target, type=CtlStatusType(type=CtlStatusType.MOVE_TO_ABSOLUTE_TARGET))\n                self.__action_active = True  # so /ib2_user/stop cancels it\n                try:\n                    self.__command.send_goal(goal)\n                    if not self.__command.wait_for_result(rospy.Duration(timeout)):\n                        self.__command.cancel_goal()\n                        return False\n                    return self.__command.get_result().type == CtlCommandResult.TERMINATE_SUCCESS\n                finally:\n                    self.__action_active = False\n",
    "comment": "            # {i}. {name}",
    "line": "            if not move_to({x}, {y}, {z}, {qx}, {qy}, {qz}, {qw}):\n                rospy.logwarn('move {i} did not finish')",
    "pass": "            rospy.sleep(1.0)  # let it settle before the judge looks\n            self.__notify_checkpoint_passed({cp})",
    "footer": "            # The template calls /event/mission_finished after this block."
  }
}
