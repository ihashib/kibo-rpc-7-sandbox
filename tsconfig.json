{
  // Type-checks src/ (npm run typecheck); rollup.config.mjs uses it to build dist/kibo-nav-sandbox.js.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "removeComments": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
